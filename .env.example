# Variables de entorno del monorepo react-fastapi-template.
#
# Copia este fichero a `.env` en la raiz del repo (no versionado) y ajusta
# los valores; `make setup` lo crea por ti si no existe. Es la unica fuente
# de configuracion del proyecto, no hay un .env por modulo: lo leen el
# backend (`make dev-back`, `make migrate`, `make seed`, los tests), Vite
# (`make dev-front`, `make test-front`) y docker compose (`make dev`,
# `make preview`, `make build`).
#
# Las variables marcadas como OBLIGATORIA no tienen valor por defecto en el
# codigo: si faltan, el backend, Vite y compose se niegan a arrancar con un
# mensaje que dice cual falta, en vez de apuntar a localhost en silencio.
#
# Otros entornos: copia este fichero tambien a `.env.staging` o `.env.prod`
# (nunca se versionan) y construye sus imagenes con `make build ENV=staging`
# o `make build ENV=prod`. Esas imagenes no se arrancan en local.

# --- Aplicacion ---
APP_NAME=fastapi-template API
ENVIRONMENT=development

# --- Base de datos (PostgreSQL 16) ---
# DB_HOST y DB_PORT: OBLIGATORIAS. DB_HOST=localhost cuando el backend o
# alembic se ejecutan en el host; dentro de docker compose el servicio
# "backend" usa siempre "postgres", el nombre del servicio en la red de Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
# OBLIGATORIA.
DB_PASSWORD=change-me-local-dev-password
DB_NAME=react-fastapi-template

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# OBLIGATORIA. Origenes permitidos para llamar a la API desde el navegador,
# separados por comas (p. ej. http://localhost:3000,http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
# OBLIGATORIA. URL de la API tal y como la ve el navegador. Vite la hornea en
# el bundle al construir, asi que cambiarla exige reconstruir la imagen del
# frontend. Puede ser una ruta relativa si un proxy sirve la API en el mismo
# origen que la SPA.
VITE_API_URL=http://localhost:8000

# --- JWT ---
# JWT_SECRET_KEY: OBLIGATORIA.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
